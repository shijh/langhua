<?xml version="1.0" encoding="UTF-8"?>
<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">

    <title>Hardware Assembly Entities</title>
    <description>Product models, BOM, routing, work orders, serial numbers, work reports and defects</description>

    <entity entity-name="MfgProduct"
            package-name="org.langhua.ofbiz.mfg"
            title="Product model">
        <description>A hardware model that is assembled, tested and packed in house</description>
        <field name="productCode" type="id"><description>Model code, e.g. BT5</description></field>
        <field name="productName" type="name"><description>Display name</description></field>
        <field name="snPrefix" type="very-short"><description>Prefix used when serial numbers are generated</description></field>
        <field name="standardHours" type="floating-point"><description>Standard assembly hours per unit</description></field>
        <field name="warrantyMonths" type="numeric"><description>Warranty in months from the delivery date, 12 when empty</description></field>
        <field name="statusId" type="id"><description>MFG_ACTIVE or MFG_INACTIVE</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="productCode"/>
    </entity>

    <entity entity-name="MfgBomItem"
            package-name="org.langhua.ofbiz.mfg"
            title="BOM line">
        <description>One component of a product model, including its reference designators</description>
        <field name="productCode" type="id"><description>Parent model</description></field>
        <field name="lineSeq" type="numeric"><description>Line number inside the BOM</description></field>
        <field name="componentCode" type="id"><description>Component part number</description></field>
        <field name="componentName" type="name"><description>Component description</description></field>
        <field name="qty" type="floating-point"><description>Quantity per unit</description></field>
        <field name="designators" type="very-long"><description>Reference designators, e.g. R1-R12,C3</description></field>
        <field name="isKeyPart" type="indicator"><description>Y when the part has to be traced</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="productCode"/>
        <prim-key field="lineSeq"/>
        <relation type="one" fk-name="MFG_BOM_PRODUCT" rel-entity-name="MfgProduct">
            <key-map field-name="productCode"/>
        </relation>
    </entity>

    <entity entity-name="MfgRouting"
            package-name="org.langhua.ofbiz.mfg"
            title="Routing operation template">
        <description>Operation template of a product model: assembly, ageing, test, packing</description>
        <field name="productCode" type="id"><description>Parent model</description></field>
        <field name="opSeq" type="numeric"><description>Operation sequence, 10, 20, 30 ...</description></field>
        <field name="opName" type="name"><description>Operation name</description></field>
        <field name="workCenter" type="short-varchar"><description>Work center / station</description></field>
        <field name="stdHours" type="floating-point"><description>Standard hours per unit</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="productCode"/>
        <prim-key field="opSeq"/>
        <relation type="one" fk-name="MFG_ROUTE_PRODUCT" rel-entity-name="MfgProduct">
            <key-map field-name="productCode"/>
        </relation>
    </entity>

    <entity entity-name="MfgWorkOrder"
            package-name="org.langhua.ofbiz.mfg"
            title="Work order">
        <description>Production order for a quantity of one product model</description>
        <field name="workOrderId" type="id"><description>Work order number</description></field>
        <field name="productCode" type="id"><description>Model to build</description></field>
        <field name="plannedQty" type="numeric"><description>Planned quantity</description></field>
        <field name="statusId" type="id"><description>MFG_CREATED, MFG_IN_PROGRESS, MFG_COMPLETED, MFG_CLOSED</description></field>
        <field name="dueDate" type="date"><description>Requested finish date</description></field>
        <field name="customerName" type="name"><description>Customer or internal project</description></field>
        <field name="smtVendor" type="name"><description>Outsourced SMT supplier name</description></field>
        <field name="smtVendorId" type="id"><description>Vendor master record used for shipping material</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="workOrderId"/>
        <relation type="one" fk-name="MFG_WO_PRODUCT" rel-entity-name="MfgProduct">
            <key-map field-name="productCode"/>
        </relation>
        <index name="MFG_WO_STATUS" unique="false">
            <index-field name="statusId"/>
        </index>
    </entity>

    <entity entity-name="MfgSn"
            package-name="org.langhua.ofbiz.mfg"
            title="Serial number">
        <description>One physical unit of a work order, traced from assembly to shipment</description>
        <field name="sn" type="id"><description>Serial number, e.g. BT5-261020-0001</description></field>
        <field name="workOrderId" type="id"><description>Owning work order</description></field>
        <field name="productCode" type="id"><description>Model</description></field>
        <field name="statusId" type="id"><description>MFG_IN_PROGRESS, MFG_COMPLETED, MFG_SCRAPPED</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="sn"/>
        <relation type="one" fk-name="MFG_SN_WO" rel-entity-name="MfgWorkOrder">
            <key-map field-name="workOrderId"/>
        </relation>
        <index name="MFG_SN_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
    </entity>

    <entity entity-name="MfgReport"
            package-name="org.langhua.ofbiz.mfg"
            title="Work report">
        <description>Reported labour of one operation: hours and quantities</description>
        <field name="reportId" type="id"><description>Report number</description></field>
        <field name="workOrderId" type="id"><description>Work order</description></field>
        <field name="opSeq" type="numeric"><description>Operation sequence</description></field>
        <field name="sn" type="id"><description>Optional single unit the report belongs to</description></field>
        <field name="operatorName" type="name"><description>Who performed the work</description></field>
        <field name="workHours" type="floating-point"><description>Reported hours</description></field>
        <field name="qtyOk" type="numeric"><description>Good quantity</description></field>
        <field name="qtyNg" type="numeric"><description>Rejected quantity</description></field>
        <field name="reportDate" type="date-time"><description>When the work was reported</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="reportId"/>
        <relation type="one" fk-name="MFG_REPORT_WO" rel-entity-name="MfgWorkOrder">
            <key-map field-name="workOrderId"/>
        </relation>
        <index name="MFG_REPORT_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
        <index name="MFG_REPORT_DATE" unique="false">
            <index-field name="reportDate"/>
        </index>
    </entity>

    <entity entity-name="MfgDefect"
            package-name="org.langhua.ofbiz.mfg"
            title="Defect record">
        <description>Non conformance found on one operation, with repair hours</description>
        <field name="defectId" type="id"><description>Defect number</description></field>
        <field name="workOrderId" type="id"><description>Work order</description></field>
        <field name="sn" type="id"><description>Unit the defect was found on</description></field>
        <field name="opSeq" type="numeric"><description>Operation where it was found</description></field>
        <field name="defectCode" type="short-varchar"><description>Defect code, e.g. MISSING_PART</description></field>
        <field name="qty" type="numeric"><description>Defective quantity</description></field>
        <field name="responsibility" type="short-varchar"><description>HOUSE, SMT, SUPPLIER or DESIGN</description></field>
        <field name="repairHours" type="floating-point"><description>Hours spent repairing</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="defectId"/>
        <relation type="one" fk-name="MFG_DEFECT_WO" rel-entity-name="MfgWorkOrder">
            <key-map field-name="workOrderId"/>
        </relation>
        <index name="MFG_DEFECT_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
    </entity>

    <entity entity-name="MfgMaterialLot"
            package-name="org.langhua.ofbiz.mfg"
            title="Material lot">
        <description>One purchased lot / reel of a component: supplier lot or date code and quantity received</description>
        <field name="lotId" type="id"><description>Internal lot id, LOT-yyMMdd-NN</description></field>
        <field name="componentCode" type="id"><description>Component part number</description></field>
        <field name="componentName" type="name"><description>Component description</description></field>
        <field name="supplierName" type="name"><description>Where the lot was bought</description></field>
        <field name="supplierLot" type="short-varchar"><description>Supplier lot / reel / date code printed on the label</description></field>
        <field name="receivedQty" type="floating-point"><description>Quantity received</description></field>
        <field name="receivedDate" type="date"><description>Date received from the supplier</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="lotId"/>
        <index name="MFG_LOT_COMPONENT" unique="false">
            <index-field name="componentCode"/>
        </index>
        <index name="MFG_LOT_SUPPLIER" unique="false">
            <index-field name="supplierLot"/>
        </index>
    </entity>

    <entity entity-name="MfgMaterialIssue"
            package-name="org.langhua.ofbiz.mfg"
            title="Material issue">
        <description>Components issued to a work order: which lot went into which build</description>
        <field name="issueId" type="id"><description>Issue number</description></field>
        <field name="workOrderId" type="id"><description>Work order the material was issued to</description></field>
        <field name="componentCode" type="id"><description>Component part number</description></field>
        <field name="lotId" type="id"><description>Lot that was issued</description></field>
        <field name="qty" type="floating-point"><description>Issued quantity</description></field>
        <field name="issuedDate" type="date"><description>Date of issue</description></field>
        <field name="designators" type="very-long"><description>Designators covered, when the SMT house reports reel changes</description></field>
        <field name="snFrom" type="id"><description>First serial number covered, when known</description></field>
        <field name="snTo" type="id"><description>Last serial number covered, when known</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="issueId"/>
        <relation type="one" fk-name="MFG_ISSUE_WO" rel-entity-name="MfgWorkOrder">
            <key-map field-name="workOrderId"/>
        </relation>
        <relation type="one" fk-name="MFG_ISSUE_LOT" rel-entity-name="MfgMaterialLot">
            <key-map field-name="lotId"/>
        </relation>
        <index name="MFG_ISSUE_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
        <index name="MFG_ISSUE_LOT_IDX" unique="false">
            <index-field name="lotId"/>
        </index>
    </entity>

    <entity entity-name="MfgShipment"
            package-name="org.langhua.ofbiz.mfg"
            title="Shipment">
        <description>Material sent to the SMT house or boards received back, with courier details</description>
        <field name="shipmentId" type="id"><description>Shipment number</description></field>
        <field name="workOrderId" type="id"><description>Work order</description></field>
        <field name="directionId" type="id"><description>MFG_SHIP_OUT to the SMT house, MFG_SHIP_IN back to us</description></field>
        <field name="shipmentDate" type="date"><description>Date shipped or received</description></field>
        <field name="qty" type="floating-point"><description>Kits sent out, or boards received back</description></field>
        <field name="defectQty" type="floating-point"><description>Defective boards found on receipt</description></field>
        <field name="carrier" type="short-varchar"><description>Courier</description></field>
        <field name="trackingNo" type="short-varchar"><description>Tracking number</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="shipmentId"/>
        <relation type="one" fk-name="MFG_SHIP_WO" rel-entity-name="MfgWorkOrder">
            <key-map field-name="workOrderId"/>
        </relation>
        <index name="MFG_SHIP_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
    </entity>

    <entity entity-name="MfgReplacement"
            package-name="org.langhua.ofbiz.mfg"
            title="Replacement during repair">
        <description>Component swapped on one unit during repair or rework, with the old and new lot</description>
        <field name="replacementId" type="id"><description>Replacement number</description></field>
        <field name="sn" type="id"><description>Unit that was repaired</description></field>
        <field name="workOrderId" type="id"><description>Work order of the unit</description></field>
        <field name="componentCode" type="id"><description>Component that was replaced</description></field>
        <field name="opSeq" type="numeric"><description>Operation where the replacement happened</description></field>
        <field name="oldLotId" type="id"><description>Lot removed from the unit</description></field>
        <field name="newLotId" type="id"><description>Lot installed on the unit</description></field>
        <field name="qty" type="floating-point"><description>Replaced quantity</description></field>
        <field name="replacedDate" type="date"><description>Date of the replacement</description></field>
        <field name="reason" type="short-varchar"><description>Why it was replaced, e.g. NO_POWER</description></field>
        <field name="hours" type="floating-point"><description>Rework hours</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="replacementId"/>
        <relation type="one" fk-name="MFG_REPL_SN" rel-entity-name="MfgSn">
            <key-map field-name="sn"/>
        </relation>
        <index name="MFG_REPL_SN_IDX" unique="false">
            <index-field name="sn"/>
        </index>
        <index name="MFG_REPL_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
    </entity>

    <entity entity-name="MfgDelivery"
            package-name="org.langhua.ofbiz.mfg"
            title="Delivery order">
        <description>Units shipped to a customer; the delivery date starts the warranty</description>
        <field name="deliveryId" type="id"><description>Delivery number, DO-yyMMdd-NN</description></field>
        <field name="customerName" type="name"><description>Customer the units were shipped to</description></field>
        <field name="customerPo" type="short-varchar"><description>Customer purchase order, optional</description></field>
        <field name="deliveryDate" type="date"><description>Date shipped, warranty start</description></field>
        <field name="carrier" type="short-varchar"><description>Courier</description></field>
        <field name="trackingNo" type="short-varchar"><description>Tracking number</description></field>
        <field name="workOrderId" type="id"><description>Work order the units came from, optional</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="deliveryId"/>
        <index name="MFG_DELIVERY_CUSTOMER" unique="false">
            <index-field name="customerName"/>
        </index>
        <index name="MFG_DELIVERY_DATE" unique="false">
            <index-field name="deliveryDate"/>
        </index>
    </entity>

    <entity entity-name="MfgDeliverySn"
            package-name="org.langhua.ofbiz.mfg"
            title="Delivered unit">
        <description>One serial number shipped with a delivery order</description>
        <field name="deliveryId" type="id"><description>Delivery order</description></field>
        <field name="sn" type="id"><description>Serial number shipped</description></field>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="deliveryId"/>
        <prim-key field="sn"/>
        <relation type="one" fk-name="MFG_DELIV_SN_DELIVERY" rel-entity-name="MfgDelivery">
            <key-map field-name="deliveryId"/>
        </relation>
        <relation type="one" fk-name="MFG_DELIV_SN_SN" rel-entity-name="MfgSn">
            <key-map field-name="sn"/>
        </relation>
        <index name="MFG_DELIV_SN_SN_IDX" unique="false">
            <index-field name="sn"/>
        </index>
    </entity>

    <entity entity-name="MfgTestResult"
            package-name="org.langhua.ofbiz.mfg"
            title="Test result">
        <description>One measured item of one unit at a test station, imported from the test bench CSV</description>
        <field name="resultId" type="id"><description>Result number</description></field>
        <field name="sn" type="id"><description>Unit under test</description></field>
        <field name="workOrderId" type="id"><description>Work order of the unit</description></field>
        <field name="station" type="short-varchar"><description>Station, e.g. FCT or AGEING</description></field>
        <field name="testItem" type="short-varchar"><description>Measured item, e.g. VBAT</description></field>
        <field name="measureValue" type="floating-point"><description>Measured value</description></field>
        <field name="unitOfMeasure" type="short-varchar"><description>Unit, e.g. V or mA</description></field>
        <field name="passFail" type="indicator"><description>Y when the item passed</description></field>
        <field name="testDate" type="date-time"><description>When the unit was tested</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="resultId"/>
        <index name="MFG_TEST_SN_IDX" unique="false">
            <index-field name="sn"/>
        </index>
        <index name="MFG_TEST_WO_IDX" unique="false">
            <index-field name="workOrderId"/>
        </index>
    </entity>

    <entity entity-name="MfgVendor"
            package-name="org.langhua.ofbiz.mfg"
            title="Outsourcing vendor">
        <description>SMT / PCB vendor with the shipping address and the customer code it assigned to us</description>
        <field name="vendorId" type="id"><description>Vendor code, V-yyMMdd-NN when generated</description></field>
        <field name="vendorName" type="name"><description>Vendor name, matched with the work order SMT vendor</description></field>
        <field name="vendorType" type="short-varchar"><description>SMT, PCB or BOTH</description></field>
        <field name="contactName" type="name"><description>Recipient of our material parcels</description></field>
        <field name="contactMobile" type="short-varchar"><description>Mobile number of the recipient</description></field>
        <field name="addressText" type="very-long"><description>Shipping address, may span several lines</description></field>
        <field name="customerCode" type="short-varchar"><description>Customer code the vendor assigned to us, printed on parcels</description></field>
        <field name="statusId" type="id"><description>MFG_ACTIVE or MFG_INACTIVE</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="vendorId"/>
        <index name="MFG_VENDOR_NAME" unique="false">
            <index-field name="vendorName"/>
        </index>
    </entity>

    <entity entity-name="MfgWarrantyClaim"
            package-name="org.langhua.ofbiz.mfg"
            title="Warranty claim">
        <description>After sales claim of one unit: warranty status is derived from the delivery date</description>
        <field name="claimId" type="id"><description>Claim number, RMA-yyMMdd-NN</description></field>
        <field name="sn" type="id"><description>Unit returned by the customer</description></field>
        <field name="workOrderId" type="id"><description>Work order of the unit</description></field>
        <field name="customerName" type="name"><description>Customer, taken from the delivery order</description></field>
        <field name="deliveryId" type="id"><description>Delivery order of the unit</description></field>
        <field name="deliveryDate" type="date"><description>Date shipped, start of the warranty</description></field>
        <field name="warrantyEndDate" type="date"><description>Delivery date plus the product warranty months</description></field>
        <field name="inWarranty" type="indicator"><description>Y when the claim arrived inside the warranty</description></field>
        <field name="receivedDate" type="date"><description>Date the unit came back</description></field>
        <field name="issueDesc" type="very-long"><description>Reported problem</description></field>
        <field name="statusId" type="id"><description>MFG_RMA_OPEN, MFG_RMA_REPAIRED, MFG_RMA_REPLACED or MFG_RMA_CLOSED</description></field>
        <field name="claimType" type="short-varchar"><description>RTN (return and refund), EXCH (exchange), REPAIR or REFUND_ONLY</description></field>
        <field name="tradeNo" type="short-varchar"><description>Marketplace order number, e.g. the Taobao trade id</description></field>
        <field name="buyerNick" type="name"><description>Buyer nickname on the marketplace</description></field>
        <field name="signedDate" type="date"><description>Date the buyer signed for the parcel, start of the seven and fifteen day windows</description></field>
        <field name="sevenDayDeadline" type="date-time"><description>End of the seven day no-reason return window: signed date, next midnight plus 168 hours</description></field>
        <field name="afterSaleDeadline" type="date-time"><description>End of the fifteen day after sales window counted from the signed date</description></field>
        <field name="refundAmount" type="currency-amount"><description>Amount refunded to the buyer</description></field>
        <field name="deductAmount" type="currency-amount"><description>Amount deducted for missing accessories or gifts</description></field>
        <field name="freightPayer" type="short-varchar"><description>SELLER when we pay the freight, BUYER otherwise</description></field>
        <field name="returnTrackingNo" type="short-varchar"><description>Tracking number of the parcel the buyer sent back</description></field>
        <field name="receivedBackDate" type="date"><description>Date the returned unit arrived back at our warehouse</description></field>
        <field name="inspectResult" type="short-varchar"><description>QUALITY, NO_FAULT, HUMAN or UNKNOWN after inspection</description></field>
        <field name="vendorClaimStatus" type="short-varchar"><description>Claim raised against the SMT house or the component supplier: NONE, SENT or RECOVERED</description></field>
        <field name="repairWorkOrderId" type="id"><description>Repair work order created for this claim</description></field>
        <field name="exchangeDeliveryId" type="id"><description>Delivery order of the replacement unit</description></field>
        <field name="responsibility" type="short-varchar"><description>HOUSE, SMT, SUPPLIER or DESIGN</description></field>
        <field name="repairHours" type="floating-point"><description>Hours spent on the repair</description></field>
        <field name="closedDate" type="date"><description>Date the claim was closed</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
