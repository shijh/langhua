<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <!-- Lots, incoming inspection, locations, transfers, counts and the stock pages. -->


    <service name="mfgLotSave" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="lotSave"            auth="false" use-transaction="false">
        <description>Create or update a material lot; lotId LOT-yyMMdd-NN is generated when omitted</description>
        <attribute name="lotId" type="String" mode="IN" optional="true"/>
        <attribute name="componentCode" type="String" mode="IN" optional="false"/>
        <attribute name="componentName" type="String" mode="IN" optional="true"/>
        <attribute name="supplierName" type="String" mode="IN" optional="true"/>
        <attribute name="supplierLot" type="String" mode="IN" optional="true"/>
        <attribute name="receivedQty" type="Double" mode="IN" optional="false"/>
        <attribute name="receivedDate" type="String" mode="IN" optional="true"/>
        <attribute name="unitPrice" type="Double" mode="IN" optional="true"/>
        <attribute name="locationId" type="String" mode="IN" optional="true"/>
        <attribute name="inspectStatusId" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="inspectStatusId" type="String" mode="OUT" optional="true"/>
        <attribute name="onHandQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="availableQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLotInspect" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="lotInspect"
            auth="false" use-transaction="false">
        <description>Record the incoming inspection of a material lot; a failed lot cannot be issued</description>
        <attribute name="lotId" type="String" mode="IN" optional="false"/>
        <attribute name="inspectStatusId" type="String" mode="IN" optional="false"/>
        <attribute name="rejectedQty" type="Double" mode="IN" optional="true"/>
        <attribute name="inspector" type="String" mode="IN" optional="true"/>
        <attribute name="inspectNote" type="String" mode="IN" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="inspectStatusId" type="String" mode="OUT" optional="true"/>
        <attribute name="rejectedQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLotRecount" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="lotRecount"
            auth="false" use-transaction="false">
        <description>Set the received quantity of a lot to the number of pieces counted, keeping the money that was paid (so the unit cost follows the count)</description>
        <attribute name="lotId" type="String" mode="IN" optional="false"/>
        <attribute name="actualQty" type="Double" mode="IN" optional="false"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="receivedQty" type="String" mode="OUT" optional="true"/>
        <attribute name="onHandQty" type="String" mode="OUT" optional="true"/>
        <attribute name="unitPrice" type="Double" mode="OUT" optional="true"/>
        <attribute name="diffQty" type="String" mode="OUT" optional="true"/>
        <attribute name="search" type="String" mode="OUT" optional="true"/>
        <attribute name="recounted" type="String" mode="OUT" optional="true"/>
        <attribute name="recountQty" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLotList" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="lotList"
            auth="false" use-transaction="false">
        <description>List material lots with received, issued and remaining quantities</description>
        <attribute name="componentCode" type="String" mode="IN" optional="true"/>
        <attribute name="kind" type="String" mode="IN" optional="true"/>
        <attribute name="search" type="String" mode="IN" optional="true"/>
        <attribute name="page" type="Long" mode="IN" optional="true"/>
        <attribute name="pageSize" type="Long" mode="IN" optional="true"/>
        <attribute name="componentCode" type="String" mode="OUT" optional="true"/>
        <attribute name="kind" type="String" mode="OUT" optional="true"/>
        <attribute name="lots" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="totalCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="page" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageSize" type="Long" mode="OUT" optional="true"/>
        <attribute name="search" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLotImportCsv" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="lotImportCsv"
            auth="false" use-transaction="false">
        <description>Import lots from CSV: componentCode,componentName,supplierName,supplierLot,qty,receivedDate</description>
        <attribute name="csv" type="String" mode="IN" optional="false"/>
        <attribute name="locationId" type="String" mode="IN" optional="true"/>
        <attribute name="importedCount" type="String" mode="OUT" optional="true"/>
        <attribute name="lotIds" type="java.util.List" mode="OUT" optional="true"/>
    </service>


    <!-- ==================== inventory: movements, stock, counts ==================== -->

    <service name="mfgInventoryMove" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="inventoryMove"
            auth="false" use-transaction="false">
        <description>Record one movement of one lot (receipt, issue, return, scrap or adjustment); the lot totals are summed from the movements</description>
        <attribute name="lotId" type="String" mode="IN" optional="false"/>
        <attribute name="movementTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="reasonEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="qty" type="Double" mode="IN" optional="false"/>
        <attribute name="unitCost" type="Double" mode="IN" optional="true"/>
        <attribute name="workOrderId" type="String" mode="IN" optional="true"/>
        <attribute name="referenceNo" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="effectiveDate" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="locationId" type="String" mode="IN" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="seqId" type="Long" mode="OUT" optional="true"/>
        <attribute name="movementTypeId" type="String" mode="OUT" optional="true"/>
        <attribute name="reasonEnumId" type="String" mode="OUT" optional="true"/>
        <attribute name="quantityDiff" type="Double" mode="OUT" optional="true"/>
        <attribute name="onHandQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="availableQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgStockSummary" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="stockSummary"
            auth="false" use-transaction="false">
        <description>Stock on hand per component with its safety stock and what to buy</description>
        <attribute name="search" type="String" mode="IN" optional="true"/>
        <attribute name="belowOnly" type="String" mode="IN" optional="true"/>
        <attribute name="page" type="String" mode="IN" optional="true"/>
        <attribute name="rows" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="componentCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="belowCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="onHandTotal" type="Double" mode="OUT" optional="true"/>
        <attribute name="valueTotal" type="Double" mode="OUT" optional="true"/>
        <attribute name="search" type="String" mode="OUT" optional="true"/>
        <attribute name="totalCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="page" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageSize" type="Long" mode="OUT" optional="true"/>
        <attribute name="message" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgInventoryLedger" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="inventoryLedger"
            auth="false" use-transaction="false">
        <description>The inventory movements, newest first, with the balance of their lot</description>
        <attribute name="lotId" type="String" mode="IN" optional="true"/>
        <attribute name="componentCode" type="String" mode="IN" optional="true"/>
        <attribute name="movementTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="reasonEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="kind" type="String" mode="IN" optional="true"/>
        <attribute name="fromDate" type="String" mode="IN" optional="true"/>
        <attribute name="toDate" type="String" mode="IN" optional="true"/>
        <attribute name="page" type="String" mode="IN" optional="true"/>
        <attribute name="rows" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="componentCode" type="String" mode="OUT" optional="true"/>
        <attribute name="movementTypeId" type="String" mode="OUT" optional="true"/>
        <attribute name="reasonEnumId" type="String" mode="OUT" optional="true"/>
        <attribute name="kind" type="String" mode="OUT" optional="true"/>
        <attribute name="fromDate" type="java.sql.Date" mode="OUT" optional="true"/>
        <attribute name="toDate" type="java.sql.Date" mode="OUT" optional="true"/>
        <attribute name="totalCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="page" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageSize" type="Long" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLocationSave" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="locationSave"
            auth="false" use-transaction="false">
        <description>Write a stock location: a warehouse, a zone or a shelf</description>
        <attribute name="locationId" type="String" mode="IN" optional="false"/>
        <attribute name="locationName" type="String" mode="IN" optional="true"/>
        <attribute name="locationTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="parentLocationId" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="locationId" type="String" mode="OUT" optional="true"/>
        <attribute name="locationTypeId" type="String" mode="OUT" optional="true"/>
        <attribute name="onHandQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLocationList" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="locationList"
            auth="false" use-transaction="false">
        <description>The stock locations with what each one holds</description>
        <attribute name="locations" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="unassignedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="onHandTotal" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgLocationStock" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="locationStock"
            auth="false" use-transaction="false">
        <description>The balance of every lot in every location</description>
        <attribute name="locationId" type="String" mode="IN" optional="true"/>
        <attribute name="componentCode" type="String" mode="IN" optional="true"/>
        <attribute name="rows" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="locationId" type="String" mode="OUT" optional="true"/>
        <attribute name="componentCode" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgStockTransfer" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="stockTransfer"
            auth="false" use-transaction="false">
        <description>Move a quantity of one lot to another location; written as a pair of movements, the lot total does not change</description>
        <attribute name="lotId" type="String" mode="IN" optional="false"/>
        <attribute name="fromLocationId" type="String" mode="IN" optional="true"/>
        <attribute name="toLocationId" type="String" mode="IN" optional="false"/>
        <attribute name="qty" type="Double" mode="IN" optional="false"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="transferId" type="String" mode="OUT" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="fromLocationId" type="String" mode="OUT" optional="true"/>
        <attribute name="toLocationId" type="String" mode="OUT" optional="true"/>
        <attribute name="qty" type="Double" mode="OUT" optional="true"/>
        <attribute name="toLocationQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="onHandQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgStockSettingSave" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="stockSettingSave"
            auth="false" use-transaction="false">
        <description>Write the component master record with its safety stock and reorder quantity</description>
        <attribute name="componentCode" type="String" mode="IN" optional="false"/>
        <attribute name="componentName" type="String" mode="IN" optional="true"/>
        <attribute name="unitOfMeasure" type="String" mode="IN" optional="true"/>
        <attribute name="minimumStock" type="Double" mode="IN" optional="true"/>
        <attribute name="reorderQty" type="Double" mode="IN" optional="true"/>
        <attribute name="supplierName" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="componentCode" type="String" mode="OUT" optional="true"/>
        <attribute name="minimumStock" type="Double" mode="OUT" optional="true"/>
        <attribute name="reorderQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgStockCount" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="stockCount"
            auth="false" use-transaction="false">
        <description>Book a physical count of one lot: the difference becomes a movement</description>
        <attribute name="lotId" type="String" mode="IN" optional="false"/>
        <attribute name="countedQty" type="Double" mode="IN" optional="false"/>
        <attribute name="counterName" type="String" mode="IN" optional="true"/>
        <attribute name="countDate" type="String" mode="IN" optional="true"/>
        <attribute name="reasonEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="physicalInventoryId" type="String" mode="OUT" optional="true"/>
        <attribute name="lotId" type="String" mode="OUT" optional="true"/>
        <attribute name="bookQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="countedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="varianceQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="reasonEnumId" type="String" mode="OUT" optional="true"/>
        <attribute name="onHandQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgStockCountList" engine="java"
            location="org.langhua.ofbiz.mfg.MfgStockServices" invoke="stockCountList"
            auth="false" use-transaction="false">
        <description>The counts that were booked, newest first</description>
        <attribute name="lotId" type="String" mode="IN" optional="true"/>
        <attribute name="counts" type="java.util.List" mode="OUT" optional="true"/>
    </service>
</services>
