<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <!-- Design BOM of a development project: importing a Fritzing sketch, comparing versions,
         locking the parts and listing what has to be bought. -->


    <!-- ==================== design BOM (Fritzing) ==================== -->

    <service name="mfgDevBomImport" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomImport"
            auth="false" use-transaction="true">
        <description>Import one version of the design BOM of a development project: parse the Fritzing HTML report (or a CSV), compare it with the version before, lock the parts on the shelf and list what is short</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="bomText" type="String" mode="IN" optional="true" allow-html="any"/>
        <attribute name="fileName" type="String" mode="IN" optional="true"/>
        <!-- the file itself, base64, so the version keeps the evidence of what the sketch said -->
        <attribute name="sourceBase64" type="String" mode="IN" optional="true" allow-html="any"/>
        <attribute name="sourceContentType" type="String" mode="IN" optional="true"/>
        <attribute name="bomVersion" type="String" mode="IN" optional="true"/>
        <attribute name="format" type="String" mode="IN" optional="true"/>
        <attribute name="lock" type="String" mode="IN" optional="true"/>
        <attribute name="consumeDropped" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="projectCode" type="String" mode="OUT" optional="true"/>
        <attribute name="importSeq" type="Long" mode="OUT" optional="true"/>
        <attribute name="bomVersion" type="String" mode="OUT" optional="true"/>
        <attribute name="bomFormat" type="String" mode="OUT" optional="true"/>
        <attribute name="itemCount" type="String" mode="OUT" optional="true"/>
        <attribute name="newCount" type="String" mode="OUT" optional="true"/>
        <attribute name="changedCount" type="String" mode="OUT" optional="true"/>
        <attribute name="sameCount" type="String" mode="OUT" optional="true"/>
        <attribute name="droppedCount" type="String" mode="OUT" optional="true"/>
        <attribute name="shortCount" type="String" mode="OUT" optional="true"/>
        <attribute name="shortQty" type="String" mode="OUT" optional="true"/>
        <attribute name="lockedQty" type="String" mode="OUT" optional="true"/>
        <attribute name="consumedQty" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgDevBomDetail" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomDetail"
            auth="false" use-transaction="false">
        <description>The current design BOM of a development project with the stock of today, the parts the version no longer uses, the shopping list and the import history</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="items" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="dropped" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="shortages" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="imports" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="stockOptions" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="latest" type="java.util.Map" mode="OUT" optional="true"/>
        <attribute name="shortCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="shortQty" type="Double" mode="OUT" optional="true"/>
    </service>

    <service name="mfgDevBomItemSave" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomItemSave"
            auth="false" use-transaction="true">
        <description>Correct the part number, the quantity or the designators of one part of the latest import, or delete a row that was typed in by hand; the lock moves with it</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="lineSeq" type="Long" mode="IN" optional="true"/>
        <attribute name="componentCode" type="String" mode="IN" optional="true"/>
        <attribute name="qty" type="Double" mode="IN" optional="true"/>
        <attribute name="designators" type="String" mode="IN" optional="true"/>
        <attribute name="delete" type="String" mode="IN" optional="true"/>
        <attribute name="lock" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="lineSeq" type="String" mode="OUT" optional="true"/>
        <attribute name="componentCode" type="String" mode="OUT" optional="true"/>
        <attribute name="deletedLine" type="String" mode="OUT" optional="true"/>
        <attribute name="deletedCode" type="String" mode="OUT" optional="true"/>
        <attribute name="lockedQty" type="String" mode="OUT" optional="true"/>
        <attribute name="shortQty" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgDevBomItemAdd" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomItemAdd"
            auth="false" use-transaction="true">
        <description>Add a part the sketch does not show (an adapter board that lets a part sit in the breadboard) to the version in use: lock it like an imported part, and carry it into the next import</description>
        <!-- the new part number is called partCode, not componentCode: the page redirects a
             componentCode, and makeQueryString falls back to the posted parameter of that name -->
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="partCode" type="String" mode="IN" optional="true"/>
        <attribute name="partName" type="String" mode="IN" optional="true"/>
        <attribute name="qty" type="Double" mode="IN" optional="true"/>
        <attribute name="designators" type="String" mode="IN" optional="true"/>
        <attribute name="lock" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="addedCode" type="String" mode="OUT" optional="true"/>
        <attribute name="addedName" type="String" mode="OUT" optional="true"/>
        <attribute name="addedLine" type="String" mode="OUT" optional="true"/>
        <attribute name="lockedQty" type="String" mode="OUT" optional="true"/>
        <attribute name="shortQty" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgDevBomSaveAll" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomSaveAll"
            auth="false" use-transaction="true">
        <description>Save every corrected part number and quantity of the latest import in one go, moving the lock of each row that changed</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="rows" type="java.util.List" mode="IN" optional="true"/>
        <attribute name="lock" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="savedLines" type="String" mode="OUT" optional="true"/>
        <attribute name="keptLines" type="String" mode="OUT" optional="true"/>
        <attribute name="goneLines" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgDevBomRelease" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomRelease"
            auth="false" use-transaction="true">
        <description>Give back every part a development project has locked; the stock itself does not change</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="releasedQty" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ==================== outbound order (出库单) ==================== -->

    <service name="mfgDevBomOutbound" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="devBomOutbound"
            auth="false" use-transaction="true">
        <description>Write the parts of the BOM version in use into an outbound order: one line per part that is still used, so the warehouse picks from a list instead of issuing part by part</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="outboundId" type="String" mode="OUT" optional="true"/>
        <attribute name="bomVersion" type="String" mode="OUT" optional="true"/>
        <attribute name="lineCount" type="String" mode="OUT" optional="true"/>
        <attribute name="totalQty" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundIssue" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundIssue"
            auth="false" use-transaction="true">
        <description>Book every line of an outbound order off the shelf, oldest lot first, giving the development project's lock back for what was picked. All or nothing: the first line that cannot be covered stops the whole document</description>
        <attribute name="outboundId" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="issuedQty" type="String" mode="OUT" optional="true"/>
        <attribute name="projectCode" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundCancel" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundCancel"
            auth="false" use-transaction="true">
        <description>Drop a draft outbound order that will not be picked, so a fresh one can be written from the version in use. A document that has already been booked cannot be dropped: undoing it would mean booking the parts back in. The reason, when the caller gives one, is kept in its own field: the note goes on saying which version the document came from, and the page reads 已作废 from the state</description>
        <attribute name="outboundId" type="String" mode="IN" optional="true"/>
        <attribute name="reason" type="String" mode="IN" optional="true"/>
        <attribute name="projectCode" type="String" mode="OUT" optional="true"/>
        <attribute name="cancelled" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundList" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundList"
            auth="false" use-transaction="false">
        <description>The outbound orders of one development project with their lines, newest first</description>
        <attribute name="projectCode" type="String" mode="IN" optional="true"/>
        <attribute name="outbounds" type="java.util.List" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundDetail" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundDetail"
            auth="false" use-transaction="false">
        <description>One outbound order with its lines, for the page that shows a single document. An unknown number is not an error: the page says so on its own. A document that has been booked also says who handed the parts over and when, read from the movements it made</description>
        <attribute name="outboundId" type="String" mode="IN" optional="true"/>
        <attribute name="outbound" type="java.util.Map" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundPack" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundPack"
            auth="false" use-transaction="true">
        <description>Record that the picked parts are packed into plastic boxes, so the box gets a label with a QR code that a phone can scan to check the picking list. Optional: one small part goes out without a box</description>
        <attribute name="outboundId" type="String" mode="IN" optional="true"/>
        <attribute name="packageCount" type="Double" mode="IN" optional="true"/>
        <attribute name="packingNote" type="String" mode="IN" optional="true"/>
        <attribute name="packed" type="String" mode="OUT" optional="true"/>
        <attribute name="packageCount" type="String" mode="OUT" optional="true"/>
        <attribute name="projectCode" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundBrowse" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundBrowse"
            auth="false" use-transaction="false">
        <description>Every outbound order, newest first, for the page the warehouse keeper works from: the picking lists are written in product development but the parts are picked at the shelf</description>
        <attribute name="search" type="String" mode="IN" optional="true"/>
        <attribute name="statusId" type="String" mode="IN" optional="true"/>
        <attribute name="page" type="String" mode="IN" optional="true"/>
        <attribute name="pageSize" type="String" mode="IN" optional="true"/>
        <attribute name="rows" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="totalCount" type="java.lang.Integer" mode="OUT" optional="true"/>
        <attribute name="pageCount" type="java.lang.Long" mode="OUT" optional="true"/>
        <attribute name="page" type="java.lang.Long" mode="OUT" optional="true"/>
        <attribute name="pageSize" type="java.lang.Long" mode="OUT" optional="true"/>
        <attribute name="search" type="String" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgOutboundReceiverSave" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="outboundReceiverSave"
            auth="false" use-transaction="true">
        <description>Write who takes the parts away (领料人) on an outbound document. The account that books the document is the warehouse keeper and ends on the stock movements; the person carrying the parts is usually not a system user, so this is a name on the paper and not a login</description>
        <attribute name="outboundId" type="String" mode="IN" optional="true"/>
        <attribute name="receiverName" type="String" mode="IN" optional="true"/>
        <attribute name="saved" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="mfgQrLogoEnsure" engine="java"
            location="org.langhua.ofbiz.mfg.MfgDevBomServices" invoke="qrLogoEnsure"
            auth="false" use-transaction="true">
        <description>Point the QR service's logo at the house mark: it draws qrcode.default.logoimage in the middle of every code, and that setting is a system property. Called with a new transaction, because it runs while a page is being rendered</description>
        <attribute name="logoPath" type="String" mode="IN" optional="true"/>
        <attribute name="changed" type="String" mode="OUT" optional="true"/>
    </service>

</services>
