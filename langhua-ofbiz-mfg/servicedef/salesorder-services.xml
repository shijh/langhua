<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <!-- Sales orders, their two level reservation and the plan that turns the shortage into work orders. -->


    <service name="mfgSalesOrderSave" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderSave"
            auth="false" use-transaction="false">
        <description>Save a sales order with its lines, then reserve what the shelf can cover</description>
        <attribute name="salesOrderId" type="String" mode="IN" optional="true"/>
        <attribute name="customerName" type="String" mode="IN" optional="false"/>
        <attribute name="customerPo" type="String" mode="IN" optional="true"/>
        <attribute name="orderDate" type="String" mode="IN" optional="true"/>
        <attribute name="dueDate" type="String" mode="IN" optional="true"/>
        <attribute name="lines" type="String" mode="IN" optional="false"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="salesOrderId" type="String" mode="OUT" optional="true"/>
        <attribute name="lineCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
        <attribute name="reservedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="shortQty" type="Double" mode="OUT" optional="true"/>
    </service>


    <service name="mfgSalesOrderReserve" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderReserve"
            auth="false" use-transaction="false">
        <description>Lock the finished goods that the shelf can cover for a sales order, oldest lot first</description>
        <attribute name="salesOrderId" type="String" mode="IN" optional="false"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="salesOrderId" type="String" mode="OUT" optional="true"/>
        <attribute name="reservedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="shortQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgSalesOrderPlan" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderPlan"
            auth="false" use-transaction="false">
        <description>Put the units the shelf cannot cover into production, one work order per line</description>
        <attribute name="salesOrderId" type="String" mode="IN" optional="false"/>
        <attribute name="salesOrderId" type="String" mode="OUT" optional="true"/>
        <attribute name="plannedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="plannedLines" type="Integer" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgSalesOrderClose" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderClose"
            auth="false" use-transaction="false">
        <description>Close a sales order and give every reservation it holds back to the shelf</description>
        <attribute name="salesOrderId" type="String" mode="IN" optional="false"/>
        <attribute name="operatorName" type="String" mode="IN" optional="true"/>
        <attribute name="salesOrderId" type="String" mode="OUT" optional="true"/>
        <attribute name="releasedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgSalesOrderLineQty" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderLineQty"
            auth="false" use-transaction="false">
        <description>Change the quantity of one order line from the list page</description>
        <attribute name="salesOrderId" type="String" mode="IN" optional="false"/>
        <attribute name="lineSeq" type="Long" mode="IN" optional="false"/>
        <attribute name="qty" type="Double" mode="IN" optional="false"/>
        <attribute name="userLogin" type="GenericValue" mode="IN" optional="true"/>
        <attribute name="salesOrderId" type="String" mode="OUT" optional="true"/>
        <attribute name="lineSeq" type="Long" mode="OUT" optional="true"/>
        <attribute name="qty" type="Double" mode="OUT" optional="true"/>
        <attribute name="reservedQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="openQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="openTotal" type="Double" mode="OUT" optional="true"/>
        <attribute name="qtyTotal" type="Double" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
    </service>


    <service name="mfgSalesOrderList" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderList"
            auth="false" use-transaction="false">
        <description>Sales orders with what each one still owes</description>
        <attribute name="search" type="String" mode="IN" optional="true"/>
        <attribute name="statusId" type="String" mode="IN" optional="true"/>
        <attribute name="page" type="Long" mode="IN" optional="true"/>
        <attribute name="pageSize" type="Long" mode="IN" optional="true"/>
        <attribute name="orders" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
        <attribute name="statuses" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="search" type="String" mode="OUT" optional="true"/>
        <attribute name="totalCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="page" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="pageSize" type="Long" mode="OUT" optional="true"/>
    </service>


    <service name="mfgSalesOrderDetail" engine="java"
            location="org.langhua.ofbiz.mfg.MfgSalesOrderServices" invoke="salesOrderDetail"
            auth="false" use-transaction="false">
        <description>One sales order with its lines, its reservations and the work orders it started</description>
        <attribute name="salesOrderId" type="String" mode="IN" optional="true"/>
        <attribute name="order" type="java.util.Map" mode="OUT" optional="true"/>
        <attribute name="items" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="reservations" type="java.util.List" mode="OUT" optional="true"/>
    </service>
</services>
