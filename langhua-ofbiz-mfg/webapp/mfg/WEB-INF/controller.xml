<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <description>Hardware Assembly Component Site Configuration File</description>

    <!-- every request the framework could not finish lands here (Step 123) -->
    <errorpage>component://mfg/webapp/mfg/error.ftl</errorpage>

    <!-- OFBiz runs this hook right after a successful login. It keeps the page the person was on
         (set by the page itself or by the framework's refused request), and the start page hands it
         back once: logging in after a restart lands on the page you were working on -->
    <after-login>
        <event type="java" path="org.langhua.ofbiz.mfg.MfgLoginEvents" invoke="afterLogin"/>
    </after-login>

    <request-map uri="main" save-last-view="true">
        <security https="true" auth="true"/>
        <event type="java" path="org.langhua.ofbiz.mfg.MfgLoginEvents" invoke="backAfterLogin"/>
        <response name="success" type="view" value="main"/>
        <response name="redirected" type="none"/>
    </request-map>

    <request-map uri="rememberReturn">
        <description>Remember the page a person was on and send them to the login form</description>
        <security https="true" auth="false"/>
        <event type="java" path="org.langhua.ofbiz.mfg.MfgLoginEvents" invoke="rememberReturn"/>
        <response name="success" type="none"/>
    </request-map>

