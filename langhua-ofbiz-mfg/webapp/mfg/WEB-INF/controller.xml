        <security https="true" auth="true"/>
        <event type="java" path="org.langhua.ofbiz.mfg.MfgImportEvents" invoke="bomImport"/>
        <response name="success" type="request-redirect" value="products">
            <redirect-parameter name="productCode"/>
            <redirect-parameter name="importedCount"/>
            <redirect-parameter name="bomFormat"/>
        </response>
        <response name="error" type="view" value="products"/>
    </request-map>

    <!-- Imports the workbook Taobao exports (已买到的宝贝 → 导出订单): one receipt per order number.
         The page script posts it and gets JSON back; a plain post is redirected with the counts. -->
