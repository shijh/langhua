{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "OFBiz: build plugin",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"gradlew.bat --no-daemon --console=plain jar"
			],
			"options": {
				"cwd": "${config:ofbiz.home}"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "OFBiz: start server",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"gradlew.bat --no-daemon --console=plain ofbiz"
			],
			"options": {
				"cwd": "${config:ofbiz.home}"
			},
			"problemMatcher": [],
			"isBackground": true,
			"group": "build"
		}
	]
}
