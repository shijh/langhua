<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">

    <!--
        Estimates the cost of the next units using a learning curve.

        historyData: history of lots, encoded as "units:cost;units:cost;..."
                     example "2:200;3:285;5:450" (2 units cost 200, 3 units cost 285, 5 units cost 450)
        methodType:  1 = Wright, 2 = Crawford (default 1)
    -->
    <service name="learningCurveEstimate" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="learningCurveEstimate"
            auth="false" export="false" validate="true">
        <description>Estimate the cost of the next units with a Wright or Crawford learning curve</description>
        <attribute name="historyData" type="String" mode="IN" optional="false">
            <description>History data encoded as "units:cost;units:cost;..."</description>
        </attribute>
        <attribute name="newUnitNumber" type="Double" mode="IN" optional="false">
            <description>Number of new units to estimate</description>
        </attribute>
        <attribute name="leastSquare" type="Double" mode="IN" optional="true" default-value="0.95">
            <description>Desired coefficient of determination (0.0 - 1.0)</description>
        </attribute>
        <attribute name="methodType" type="Integer" mode="IN" optional="true" default-value="1">
            <description>1 = Wright, 2 = Crawford</description>
        </attribute>
        <attribute name="estimate" type="Double" mode="OUT"/>
        <attribute name="unitCost" type="Double" mode="OUT"/>
        <attribute name="slope" type="Double" mode="OUT"/>
        <attribute name="intercept" type="Double" mode="OUT"/>
        <attribute name="leastSquareActual" type="Double" mode="OUT"/>
        <attribute name="qualifiedRowCount" type="Integer" mode="OUT"/>
    </service>

    <!--
        Returns the fitted curve parameters without estimating a new lot.
    -->
    <service name="learningCurveParameters" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="learningCurveParameters"
            auth="false" export="false" validate="true">
        <description>Return the fitted learning curve parameters</description>
        <attribute name="historyData" type="String" mode="IN" optional="false">
            <description>History data encoded as "units:cost;units:cost;..."</description>
        </attribute>
        <attribute name="leastSquare" type="Double" mode="IN" optional="true" default-value="0.95"/>
        <attribute name="methodType" type="Integer" mode="IN" optional="true" default-value="1"/>
        <attribute name="slope" type="Double" mode="OUT"/>
        <attribute name="intercept" type="Double" mode="OUT"/>
        <attribute name="leastSquareActual" type="Double" mode="OUT"/>
        <attribute name="cumulativeX" type="Double" mode="OUT"/>
        <attribute name="qualifiedRowCount" type="Integer" mode="OUT"/>
        <attribute name="filteredRowCount" type="Integer" mode="OUT"/>
    </service>

    <!--
        Computes the estimate and stores it (header + history batches) so it can be listed and exported.
    -->
    <service name="learningCurveSaveEstimate" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="saveEstimate"
            auth="false" export="false" validate="true">
        <description>Compute and store a learning curve estimate</description>
        <attribute name="productCode" type="String" mode="IN" optional="false">
            <description>Product model / project code</description>
        </attribute>
        <attribute name="measureType" type="String" mode="IN" optional="true" default-value="COST">
            <description>COST or HOURS</description>
        </attribute>
        <attribute name="historyData" type="String" mode="IN" optional="false">
            <description>History data encoded as "units:value;units:value;..."</description>
        </attribute>
        <attribute name="newUnitNumber" type="Double" mode="IN" optional="false"/>
        <attribute name="leastSquare" type="Double" mode="IN" optional="true" default-value="0.95"/>
        <attribute name="methodType" type="Integer" mode="IN" optional="true" default-value="1"/>
        <attribute name="estimateId" type="String" mode="OUT"/>
        <attribute name="estimate" type="Double" mode="OUT"/>
        <attribute name="unitCost" type="Double" mode="OUT"/>
        <attribute name="slope" type="Double" mode="OUT"/>
        <attribute name="intercept" type="Double" mode="OUT"/>
        <attribute name="leastSquareActual" type="Double" mode="OUT"/>
        <attribute name="qualifiedRowCount" type="Integer" mode="OUT"/>
        <attribute name="filteredRowCount" type="Integer" mode="OUT"/>
    </service>

    <!-- Stored estimates, newest first (optionally filtered by product code) -->
    <service name="learningCurveListEstimates" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="listEstimates"
            auth="false" export="false" validate="true">
        <description>List stored learning curve estimates</description>
        <attribute name="productCode" type="String" mode="IN" optional="true"/>
        <attribute name="estimates" type="java.util.List" mode="OUT"/>
    </service>

    <!-- Chart series (actual vs fitted unit values) for one stored estimate -->
    <service name="learningCurveChartData" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="chartData"
            auth="false" export="false" validate="true">
        <description>Chart series of a stored estimate</description>
        <attribute name="estimateId" type="String" mode="IN" optional="false"/>
        <attribute name="estimate" type="java.util.Map" mode="OUT"/>
        <attribute name="batches" type="java.util.List" mode="OUT"/>
        <attribute name="points" type="java.util.List" mode="OUT"/>
        <attribute name="maxX" type="Double" mode="OUT"/>
        <attribute name="maxY" type="Double" mode="OUT"/>
        <attribute name="productCode" type="String" mode="OUT"/>
        <attribute name="measureType" type="String" mode="OUT"/>
    </service>

    <!--
        History batches taken from the MES component: one batch per work order of the model,
        quantity = reported good units, value = reported hours.

        The MES entities are read directly; when that component is not deployed the service
        returns an empty result with a message instead of failing.
    -->
    <service name="learningCurveMesBatches" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="mesBatches"
            auth="false" export="false" validate="true">
        <description>Build the history batches of one model from the MES work orders</description>
        <attribute name="productCode" type="String" mode="IN" optional="true">
            <description>Model code; empty returns an empty result</description>
        </attribute>
        <attribute name="productCode" type="String" mode="OUT" optional="true"/>
        <attribute name="batches" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="batchCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="skippedCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="totalQty" type="Double" mode="OUT" optional="true"/>
        <attribute name="totalHours" type="Double" mode="OUT" optional="true"/>
        <attribute name="historyData" type="String" mode="OUT" optional="true"/>
        <attribute name="message" type="String" mode="OUT" optional="true"/>
    </service>

    <!--
        Software quotes: the formulas live in the MES component (mfgSoftwareEstimate), the quote is
        kept here. UFP = 35 x ILF + 15 x EIF, AE = PDR x UFP x SWF x RDF,
        D = 1.277 x (AE/176)^0.404, price = person days x day rate + VAT + non labour cost.
    -->
    <service name="learningCurveSoftwareQuote" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="softwareQuote"
            auth="false" export="false" validate="true">
        <description>Quote software from its function points through the MES cost model</description>
        <attribute name="ilfCount" type="Double" mode="IN" optional="true"/>
        <attribute name="eifCount" type="Double" mode="IN" optional="true"/>
        <attribute name="ufp" type="Double" mode="IN" optional="true"/>
        <attribute name="swfBase" type="Double" mode="IN" optional="true"/>
        <attribute name="swfReuse" type="Double" mode="IN" optional="true"/>
        <attribute name="swfPreInvest" type="Double" mode="IN" optional="true"/>
        <attribute name="swfQuality" type="Double" mode="IN" optional="true"/>
        <attribute name="rdf" type="Double" mode="IN" optional="true"/>
        <attribute name="pdrHoursPerFp" type="Double" mode="IN" optional="true"/>
        <attribute name="dayRate" type="Double" mode="IN" optional="true"/>
        <attribute name="taxRate" type="Double" mode="IN" optional="true"/>
        <attribute name="dncRate" type="Double" mode="IN" optional="true"/>
        <attribute name="ufp" type="Double" mode="OUT" optional="true"/>
        <attribute name="swf" type="Double" mode="OUT" optional="true"/>
        <attribute name="effortHours" type="Double" mode="OUT" optional="true"/>
        <attribute name="effortDays" type="Double" mode="OUT" optional="true"/>
        <attribute name="scheduleMonths" type="Double" mode="OUT" optional="true"/>
        <attribute name="amountBeforeTax" type="Double" mode="OUT" optional="true"/>
        <attribute name="taxAmount" type="Double" mode="OUT" optional="true"/>
        <attribute name="amountWithTax" type="Double" mode="OUT" optional="true"/>
        <attribute name="dncAmount" type="Double" mode="OUT" optional="true"/>
        <attribute name="totalAmount" type="Double" mode="OUT" optional="true"/>
        <attribute name="costPerFp" type="Double" mode="OUT" optional="true"/>
    </service>

    <service name="learningCurveSaveSoftwareQuote" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="saveSoftwareQuote"
            auth="false" export="false" validate="true">
        <description>Quote software and keep the result with the parameters that produced it</description>
        <attribute name="projectName" type="String" mode="IN" optional="false"/>
        <attribute name="customerName" type="String" mode="IN" optional="true"/>
        <attribute name="ilfCount" type="Double" mode="IN" optional="true"/>
        <attribute name="eifCount" type="Double" mode="IN" optional="true"/>
        <attribute name="ufp" type="Double" mode="IN" optional="true"/>
        <attribute name="swfBase" type="Double" mode="IN" optional="true"/>
        <attribute name="swfReuse" type="Double" mode="IN" optional="true"/>
        <attribute name="swfPreInvest" type="Double" mode="IN" optional="true"/>
        <attribute name="swfQuality" type="Double" mode="IN" optional="true"/>
        <attribute name="rdf" type="Double" mode="IN" optional="true"/>
        <attribute name="pdrHoursPerFp" type="Double" mode="IN" optional="true"/>
        <attribute name="dayRate" type="Double" mode="IN" optional="true"/>
        <attribute name="taxRate" type="Double" mode="IN" optional="true"/>
        <attribute name="dncRate" type="Double" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <attribute name="quoteId" type="String" mode="OUT" optional="true"/>
        <attribute name="ufp" type="Double" mode="OUT" optional="true"/>
        <attribute name="effortHours" type="Double" mode="OUT" optional="true"/>
        <attribute name="effortDays" type="Double" mode="OUT" optional="true"/>
        <attribute name="scheduleMonths" type="Double" mode="OUT" optional="true"/>
        <attribute name="amountBeforeTax" type="Double" mode="OUT" optional="true"/>
        <attribute name="amountWithTax" type="Double" mode="OUT" optional="true"/>
        <attribute name="totalAmount" type="Double" mode="OUT" optional="true"/>
    </service>

    <service name="learningCurveListSoftwareQuotes" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="listSoftwareQuotes"
            auth="false" export="false" validate="true">
        <description>Saved software quotes, newest first, with the last one as the default of the form</description>
        <attribute name="quotes" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="quoteCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="totalAmount" type="Double" mode="OUT" optional="true"/>
        <attribute name="lastQuote" type="java.util.Map" mode="OUT" optional="true"/>
    </service>

    <service name="learningCurvePdrForecast" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="pdrForecast"
            auth="false" export="false" validate="true">
        <description>Forecast the hours per function point of the next delivery from the finished software projects of MES</description>
        <attribute name="leastSquare" type="Double" mode="IN" optional="true"/>
        <attribute name="samples" type="java.util.List" mode="OUT" optional="true"/>
        <attribute name="sampleCount" type="Integer" mode="OUT" optional="true"/>
        <attribute name="predictedPdr" type="Double" mode="OUT" optional="true"/>
        <attribute name="slope" type="Double" mode="OUT" optional="true"/>
        <attribute name="intercept" type="Double" mode="OUT" optional="true"/>
        <attribute name="leastSquare" type="Double" mode="OUT" optional="true"/>
        <attribute name="message" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="learningCurveQuoteToProject" engine="java"
            location="org.langhua.ofbiz.learningcurve.LearningCurveServices" invoke="quoteToProject"
            auth="false" export="false" validate="true">
        <description>Create a software project of the MES component from a saved quote; calling it again returns the project it already made</description>
        <attribute name="quoteId" type="String" mode="IN" optional="false"/>
        <attribute name="categoryId" type="String" mode="IN" optional="true"/>
        <attribute name="projectCode" type="String" mode="OUT" optional="true"/>
        <attribute name="message" type="String" mode="OUT" optional="true"/>
    </service>
</services>
