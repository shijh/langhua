<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <description>Learning Curve Component Site Configuration File</description>

    <!-- every request the framework could not finish lands here (Step 123) -->
    <errorpage>component://learningcurve/webapp/learningcurve/error.ftl</errorpage>

    <!-- runs after every request: a request that changed a document leaves one line in the audit
         log (Step 125b), the same table the MES component writes -->
    <postprocessor>
        <event name="audit" type="java" path="org.langhua.ofbiz.mfg.MfgLoginEvents" invoke="auditRequest"/>
    </postprocessor>

    <!-- the stock login, through the MES event so every attempt lands in the same audit log
         (Step 125); the answers are the ones LoginWorker gives -->
    <request-map uri="login">
        <security https="true" auth="false"/>
        <event type="java" path="org.langhua.ofbiz.mfg.MfgLoginEvents" invoke="login"/>
        <response name="success" type="view" value="main"/>
        <response name="requirePasswordChange" type="view" value="requirePasswordChange"/>
        <response name="error" type="view" value="login"/>
    </request-map>

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>
    <request-map uri="estimate">
        <security https="true" auth="true"/>
        <event type="service" invoke="learningCurveSaveEstimate"/>
        <response name="success" type="request-redirect" value="recordDetail">
            <redirect-parameter name="estimateId"/>
        </response>
        <response name="error" type="view" value="main"/>
    </request-map>

    <request-map uri="records">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="records"/>
    </request-map>

    <request-map uri="quote">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="quote"/>
    </request-map>

    <request-map uri="quoteSave">
        <security https="true" auth="true"/>
        <event type="service" invoke="learningCurveSaveSoftwareQuote"/>
        <response name="success" type="request-redirect" value="quote">
            <redirect-parameter name="quoteId"/>
        </response>
        <response name="error" type="view" value="quote"/>
    </request-map>

    <request-map uri="quoteToProject">
        <security https="true" auth="true"/>
        <event type="service" invoke="learningCurveQuoteToProject"/>
        <response name="success" type="request-redirect" value="quote"/>
        <response name="error" type="view" value="quote"/>
    </request-map>

    <request-map uri="exportQuotesCsv">
        <security https="true" auth="true"/>
        <event type="java" path="org.langhua.ofbiz.learningcurve.LearningCurveEvents" invoke="exportQuotesCsv"/>
        <response name="success" type="none"/>
        <response name="error" type="view" value="quote"/>
    </request-map>

    <request-map uri="recordDetail">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="recordDetail"/>
    </request-map>

    <!-- "forgot my password": the stock map sends the found hint to the start page (LoginEvents
         answers "auth" when it has a hint, with the text in _EVENT_MESSAGE_); keep the person on
         our own page instead, where signIn.groovy turns that text into Chinese -->
    <request-map uri="forgotPassword">
        <security https="true" auth="false"/>
        <event type="java" path="org.langhua.ofbiz.mfg.MfgLoginEvents" invoke="forgotPassword"/>
        <response name="success" type="view" value="forgotPassword"/>
        <response name="error" type="view" value="forgotPassword"/>
        <response name="auth" type="view" value="forgotPassword"/>
    </request-map>

    <!-- the password gate posts here (the service lives in the MES component); a changed password
         sends the user back to the login screen so the new one is used right away -->
    <request-map uri="changePasswordSave">
        <security https="true" auth="true"/>
        <event type="service" invoke="mfgChangePassword"/>
        <response name="success" type="request-redirect" value="logout"/>
        <response name="error" type="view" value="main"/>
    </request-map>

    <!-- write the hours of a curve back into the standard hours of the MES model -->
    <request-map uri="standardHoursApply">
        <security https="true" auth="true"/>
        <event type="service" invoke="learningCurveApplyStandardHours"/>
        <response name="success" type="request-redirect" value="recordDetail">
            <redirect-parameter name="estimateId"/>
            <redirect-parameter name="applied"/>
        </response>
        <response name="error" type="view" value="recordDetail"/>
    </request-map>

    <request-map uri="exportCsv">
        <security https="true" auth="true"/>
        <event type="java" path="org.langhua.ofbiz.learningcurve.LearningCurveEvents" invoke="exportEstimateCsv"/>
        <response name="success" type="none"/>
        <response name="error" type="view" value="records"/>
    </request-map>

    <!-- the two pages in front of the component (Step 123): our view maps replace the stock OFBiz
         screens (a view map defined here pushes over the one from common-controller.xml) -->
    <view-map name="login" type="screen" page="component://learningcurve/widget/LearningCurveLoginScreens.xml#login" auth="false"/>
    <view-map name="forgotPassword" type="screen" page="component://learningcurve/widget/LearningCurveLoginScreens.xml#forgotPassword" auth="false"/>
    <view-map name="requirePasswordChange" type="screen" page="component://learningcurve/widget/LearningCurveLoginScreens.xml#requirePasswordChange"/>

    <view-map name="main" type="screen" page="component://learningcurve/widget/LearningCurveScreens.xml#main"/>
    <view-map name="records" type="screen" page="component://learningcurve/widget/LearningCurveScreens.xml#records"/>
    <view-map name="recordDetail" type="screen" page="component://learningcurve/widget/LearningCurveScreens.xml#recordDetail"/>
    <view-map name="quote" type="screen" page="component://learningcurve/widget/LearningCurveScreens.xml#quote"/>
</site-conf>
