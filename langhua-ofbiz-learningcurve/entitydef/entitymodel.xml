<?xml version="1.0" encoding="UTF-8"?>
<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">

    <title>Learning Curve Entities</title>
    <description>Cost / work-time learning curve estimates (internal use)</description>

    <entity entity-name="LearningCurveEstimate"
            package-name="org.langhua.ofbiz.learningcurve"
            title="Learning curve estimate header">
        <description>One estimation run: product, measurement type, method and fitted parameters</description>
        <field name="estimateId" type="id"><description>Primary key</description></field>
        <field name="productCode" type="short-varchar"><description>Product model / project code</description></field>
        <field name="measureType" type="short-varchar"><description>COST or HOURS</description></field>
        <field name="methodType" type="numeric"><description>1 = Wright, 2 = Crawford</description></field>
        <field name="leastSquareTarget" type="floating-point"><description>Requested R squared</description></field>
        <field name="newUnitNumber" type="floating-point"><description>Number of new units estimated</description></field>
        <field name="estimateTotal" type="floating-point"><description>Estimated total cost / hours</description></field>
        <field name="estimateUnit" type="floating-point"><description>Estimated unit cost / hours</description></field>
        <field name="slope" type="floating-point"><description>Fitted slope</description></field>
        <field name="intercept" type="floating-point"><description>Fitted intercept</description></field>
        <field name="leastSquareActual" type="floating-point"><description>Achieved R squared</description></field>
        <field name="qualifiedRows" type="numeric"><description>Rows kept in the fit</description></field>
        <field name="filteredRows" type="numeric"><description>Outliers removed</description></field>
        <field name="historyData" type="very-long"><description>Raw input, units:value;units:value</description></field>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="estimateId"/>
        <index name="LC_EST_PRODUCT" unique="false">
            <index-field name="productCode"/>
        </index>
        <index name="LC_EST_CREATED" unique="false">
            <index-field name="createdStamp"/>
        </index>
    </entity>

    <entity entity-name="LearningCurveBatch"
            package-name="org.langhua.ofbiz.learningcurve"
            title="Learning curve history batch">
        <description>History batch used by an estimate: lot size and its total cost / hours</description>
        <field name="estimateId" type="id"><description>Parent estimate</description></field>
        <field name="batchSeq" type="numeric"><description>Batch number inside the estimate</description></field>
        <field name="lotSize" type="floating-point"><description>Units produced in this batch</description></field>
        <field name="lotValue" type="floating-point"><description>Total cost / hours of this batch</description></field>
        <prim-key field="estimateId"/>
        <prim-key field="batchSeq"/>
        <relation type="one" fk-name="LC_BATCH_EST" rel-entity-name="LearningCurveEstimate">
            <key-map field-name="estimateId"/>
        </relation>
    </entity>

    <entity entity-name="LearningCurveSoftwareQuote"
            package-name="org.langhua.ofbiz.learningcurve"
            title="Software quote">
        <description>One software quotation: the size, the parameters used and the prices the standard gives, kept as a snapshot</description>
        <field name="quoteId" type="id"><description>Primary key</description></field>
        <field name="projectName" type="name"><description>What is being quoted</description></field>
        <field name="customerName" type="name"><description>Who the quote is for, may be empty</description></field>
        <field name="ilfCount" type="floating-point"><description>Internal logical files</description></field>
        <field name="eifCount" type="floating-point"><description>External interface files</description></field>
        <field name="ufp" type="floating-point"><description>Unadjusted function points, 35 x ILF + 15 x EIF when the ILF and EIF are given</description></field>
        <field name="swfBase" type="floating-point"><description>Software factor starting value</description></field>
        <field name="swfReuse" type="floating-point"><description>Adjustment for reuse and experience</description></field>
        <field name="swfPreInvest" type="floating-point"><description>Adjustment for design work already paid for</description></field>
        <field name="swfQuality" type="floating-point"><description>Adjustment for a certified quality system</description></field>
        <field name="rdf" type="floating-point"><description>Development factor</description></field>
        <field name="pdrHoursPerFp" type="floating-point"><description>Hours per function point used for the quote</description></field>
        <field name="dayRate" type="currency-amount"><description>Price of one person day before tax</description></field>
        <field name="taxRate" type="floating-point"><description>VAT rate</description></field>
        <field name="dncRate" type="floating-point"><description>Direct non labour cost as a share of the taxed amount</description></field>
        <field name="effortHours" type="floating-point"><description>Estimated effort in hours</description></field>
        <field name="effortDays" type="floating-point"><description>Estimated effort in person days</description></field>
        <field name="scheduleMonths" type="floating-point"><description>Estimated schedule in months</description></field>
        <field name="amountBeforeTax" type="currency-amount"><description>Price before tax</description></field>
        <field name="taxAmount" type="currency-amount"><description>VAT</description></field>
        <field name="amountWithTax" type="currency-amount"><description>Price with VAT</description></field>
        <field name="dncAmount" type="currency-amount"><description>Direct non labour cost</description></field>
        <field name="totalAmount" type="currency-amount"><description>Total of the quote</description></field>
        <field name="projectCode" type="short-varchar"><description>Software project of the appliance component created from this quote, empty until it is</description></field>
        <field name="note" type="description"/>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="quoteId"/>
        <index name="LC_QUOTE_CREATED" unique="false">
            <index-field name="createdStamp"/>
        </index>
    </entity>
    <entity entity-name="LearningCurveHoursApply"
            package-name="org.langhua.ofbiz.learningcurve"
            title="Standard hours written back to the MES model">
        <description>One backfill: the curve of an estimate turned into the standard hours of a model, kept so the old value is never lost</description>
        <field name="applyId" type="id"><description>Primary key</description></field>
        <field name="productCode" type="short-varchar"><description>Model whose standard hours were written</description></field>
        <field name="estimateId" type="id"><description>Estimate the hours came from</description></field>
        <field name="baseQty" type="floating-point"><description>Lot size the curve was asked about, the hours are that lot divided by it</description></field>
        <field name="oldHours" type="floating-point"><description>Standard hours before the backfill</description></field>
        <field name="newHours" type="floating-point"><description>Standard hours after the backfill</description></field>
        <field name="methodType" type="numeric"><description>1 = Wright, 2 = Crawford</description></field>
        <field name="slope" type="floating-point"><description>Fitted slope at the time of the backfill</description></field>
        <field name="intercept" type="floating-point"><description>Fitted intercept at the time of the backfill</description></field>
        <field name="appliedBy" type="name"><description>Who pressed the button, empty for a service call</description></field>
        <field name="createdStamp" type="date-time"/>
        <field name="createdTxStamp" type="date-time"/>
        <field name="lastUpdatedStamp" type="date-time"/>
        <field name="lastUpdatedTxStamp" type="date-time"/>
        <prim-key field="applyId"/>
        <index name="LC_APPLY_PRODUCT" unique="false">
            <index-field name="productCode"/>
        </index>
    </entity>
</entitymodel>
