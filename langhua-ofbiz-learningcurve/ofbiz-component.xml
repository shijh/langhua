<?xml version="1.0" encoding="UTF-8"?>
<ofbiz-component name="learningcurve"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">
    <!-- Component sources live in src/main/java and are compiled by the OFBiz build -->
    <resource-loader name="main" type="component"/>
    <classpath type="dir" location="config"/>

    <!-- Entities: estimate header + history batches -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>
    <entity-resource type="group" reader-name="main" loader="main" location="entitydef/entitygroup.xml"/>

    <!-- Security permissions of the component -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/LearningCurveSecurityPermissionSeedData.xml"/>

    <!-- Learning curve estimation services -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <!-- Web application: estimation page -->
    <webapp name="learningcurve"
            title="Learning Curve"
            server="default-server"
            location="webapp/learningcurve"
            base-permission="OFBTOOLS"
            mount-point="/learningcurve"
            app-bar-display="false"/>
</ofbiz-component>
